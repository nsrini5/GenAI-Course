# Copy to .env and edit:  cp .env.example .env

# ---- Generation: anthropic | openai | ollama | none
# "none" returns graph facts + top passages without an LLM (good for a first test).
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=

# ---- Stage 2: text splitter
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# ---- Stage 3: embedding (fastembed | lsa)
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Stage 4: vector DB (Qdrant)
# Leave empty on your Mac = embedded Qdrant on disk. Docker Compose sets http://qdrant:6333.
QDRANT_URL=
QDRANT_COLLECTION=spotify_architecture

# ---- Stage 5-6: entity extraction & relationship mapping
# rules = deterministic extractor; llm = rules + extra triples from the LLM (costs tokens)
KG_EXTRACTOR=rules
KG_HOPS=1
KG_MAX_FACTS=12

# ---- Graph DB (Neo4j)
# Leave NEO4J_URI empty on your Mac unless Neo4j is running. Docker Compose sets bolt://neo4j:7687.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# ---- Fusion
TOP_K=5
CANDIDATES=20
RRF_K=60
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.0
GRAPH_WEIGHT=1.0

# ---- API protection (strongly recommended on a public VPS)
API_KEY=change-me-to-a-long-random-string
HOST_PORT=8000
